# === LOCAL (default) — Docker Postgres on your Mac ===
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=seo_storyboard
DATABASE_USER=seo
DATABASE_PASSWORD=changeme
DATABASE_SSL=false

# Start DB: npm run db:up
# Setup:    npm run setup
# Dev:      npm run dev
# All-in-one: npm run dev:local

# DataForSEO — https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Serper.dev — cheap SERP/keyword discovery (PREFERRED over DataForSEO)
# Get a key at https://serper.dev — used for autocomplete, PAA, related searches, SERP.
SERPER_API_KEY=

# AI — DeepSeek preferred (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Fallback OpenAI-compatible (OpenRouter, OpenAI, Groq, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=openai/gpt-4o-mini

# WordPress (optional)
WP_SITE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Kloudbean RAG knowledge base (grounds content in live product facts)
# Defaults to the hosted endpoint; set KLOUDBEAN_RAG_DISABLED=1 to turn off.
KLOUDBEAN_RAG_URL=https://vhbbmovxfuuqzfywysba.supabase.co/functions/v1/rag-chat
# KLOUDBEAN_RAG_DISABLED=1

# Content Quality Engine tuning
CONTENT_MIN_SCORE=82          # auto-revise until the draft scores at least this
CONTENT_MAX_REVISIONS=2       # max AI editor passes per article

# Automation (scripts/automate.mjs — schedule with cron when self-hosting)
# AUTOMATE_LIMIT=5
# AUTOMATE_PUBLISH=1          # 1 = auto-publish high-scoring drafts
# AUTOMATE_PUBLISH_STATUS=publish   # draft | publish
# AUTOMATE_MIN_SCORE=88      # only auto-publish at/above this score

PORT=3000

# WordPress Plugin (Kloudbean SEO Engine plugin) — replaces basic WP REST
# WP_PLUGIN_URL=https://kloudbean.com/wp-json/kbseo/v1
# WP_PLUGIN_API_KEY=from-wp-admin-settings-page

# Tool pages: signup gate (lead-gen — require a console account to use a tool)
# TOOL_SIGNUP_URL=https://console.kloudbean.com   # where the gate sends users
# TOOL_GATE_MODE=soft           # soft (1 free use then gate) | hard (locked immediately)
# TOOL_GATE_FREE=1              # free interactions before the gate (soft mode)
# TOOL_GATE_DEFAULT=0           # 1 = gate every NEW generated tool by default

# Image generation (optional — falls back to stock photos, then placeholder)
# UNSPLASH_ACCESS_KEY=your-unsplash-key
# PEXELS_API_KEY=your-pexels-key

# Autopilot scheduler (fully autonomous mode)
# AUTOPILOT_ENABLED=1
# AUTOPILOT_INTERVAL_MS=21600000    # 6 hours
# AUTOPILOT_MAX_PER_DAY=2
# AUTOPILOT_MAX_PER_WEEK=7
# AUTOPILOT_MIN_SCORE=85
# AUTOPILOT_TOPICS_PER_RUN=5
# AUTOPILOT_PROGRESS_PER_RUN=3
# AUTOPILOT_GEO=global
# AUTOPILOT_PUBLISH=1               # 0 to disable auto-publish
# AUTOPILOT_USE_PLUGIN=1            # 0 to use basic WP REST instead

# --- Autopilot: Tool Pages phase (Elementor free tools) ---
# AUTOPILOT_TOOLS=1                 # master switch for the tool-pages phase (default off)
# AUTOPILOT_TOOLS_DISCOVER=3        # discover N new tool ideas per cycle (0 = off)
# AUTOPILOT_TOOLS_GENERATE=1        # generate N pending ideas into full tools per cycle
# AUTOPILOT_TOOLS_PUBLISH=draft     # off | draft | publish (draft = review before live)
# AUTOPILOT_TOOLS_OPTIMIZE=3        # optimize N worst-scoring existing pages per cycle (additive, slug-safe)
# AUTOPILOT_JOBS_PER_RUN=10         # durable bulk jobs (build/optimize) drained per cycle
# TOOL_MIN_QUALITY=70               # min tool quality score to auto-publish LIVE

# Weekly digest notification (Slack/Discord webhook)
# DIGEST_WEBHOOK_URL=https://hooks.slack.com/services/...

# === OWN ANALYTICS — Google Search Console (free, first-party ranking data) ===
# This replaces any paid third-party ranking tool. Real clicks/impressions/
# position per URL feed the self-learning ranker so discovery learns what wins.
# Setup:
#   1. Google Cloud Console → create a service account → create a JSON key.
#   2. Search Console → Settings → Users and permissions → add the service
#      account email as a user on the kloudbean.com property (Restricted is fine).
#   3. Fill these in (keep the \n escapes in the private key on one line):
# GSC_CLIENT_EMAIL=seo-engine@your-project.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# GSC_SITE_URL=https://www.kloudbean.com/        # or: sc-domain:kloudbean.com

# Instant indexing (B1) — push new/updated URLs to search engines on publish.
#   IndexNow (Bing/Yandex/Seznam/Naver): the WP plugin auto-hosts a key file and
#   submits on publish, so no config is needed. To run IndexNow from the engine
#   with your own key instead, set INDEXNOW_KEY (and host {key}.txt at site root).
# INDEXNOW_KEY=
# INDEXNOW_DISABLED=1                              # set to disable IndexNow entirely
#   Google Indexing API (optional, needs extra setup): reuses the GSC service
#   account, but it must be added as an OWNER of the property and the Indexing
#   API must be enabled in the Google Cloud project. Then:
# GOOGLE_INDEXING_ENABLED=1

# Multi-engine AI citation tracking (A2) — is Kloudbean cited in AI answers?
# Each engine is optional + independent; add the keys for the ones you want.
# PERPLEXITY_API_KEY=pplx-...            # Perplexity (real source citations)
# PERPLEXITY_MODEL=sonar
# GEMINI_API_KEY=...                     # Gemini (Google-grounded answers + sources)
# GEMINI_MODEL=gemini-2.0-flash
#   OpenAI/ChatGPT citation checks reuse OPENAI_API_KEY (only when it's a real
#   OpenAI key, not DeepSeek/OpenRouter). Brand-mention proxy from model knowledge.
# CITATION_OPENAI_MODEL=gpt-4o-mini

# Autopilot: periodically probe AI engines for Kloudbean citations (needs the
# citation API keys above). Off by default.
# AUTOPILOT_CITATIONS=1
# AUTOPILOT_CITATIONS_PER_RUN=5

# Entity boilerplate (C4) — official Kloudbean profiles for Organization sameAs
# (G2, LinkedIn, Crunchbase, etc.). Comma-separated. Left empty by default so we
# never ship guessed profile URLs. The WP plugin also serves /llms.txt site-wide.
# KLOUDBEAN_SAMEAS=https://www.linkedin.com/company/kloudbean,https://www.g2.com/products/kloudbean

# Article author for E-E-A-T (schema expansion). If set, articles attribute a
# real Person (stronger E-E-A-T); otherwise the Kloudbean Editorial Team.
# ARTICLE_AUTHOR_NAME=Jane Doe
# ARTICLE_AUTHOR_URL=https://kloudbean.com/author/jane

# Freshness / decay: how many days before a published article is due for review.
# (Falls back to AUTOPILOT_REFRESH_DAYS, then 90.) The autopilot refreshes the
# highest-priority due articles each cycle (prioritised by GSC decay signal).
# CONTENT_REVIEW_DAYS=90

# Conversion attribution: console.kloudbean.com reports signup/paid events to the
# WP plugin webhook so the engine can attribute them to the page that drove them
# and optimise the learning loop for revenue (not just clicks).
#   Webhook (console -> plugin, authenticated with the plugin API key):
#     POST https://www.kloudbean.com/wp-json/kbseo/v1/conversion
#     Header: X-KB-API-Key: <WP_PLUGIN_API_KEY>
#     Body: {"event":"signup|paid","external_id":"...","value":12.0,"currency":"USD",
#            "source_url":"<the inbound link with kbsrc/kbsurface>","plan":"..."}
#   Console links already carry kbsrc (source slug) + kbsurface (tool|article).
#   The engine auto-pulls + attributes on each autopilot cycle (no extra env needed).

# ============================================================================
# GO-TO-MARKET LAYER — distribution, Reddit listening, and outreach.
#
# Nothing here is required to DRAFT anything. Channel assets, email bodies,
# Reddit reply drafts and outreach copy all generate without a single credential.
# These variables only matter when you want to actually SEND or to read Reddit.
# ============================================================================

# --- Growth automation (schedule) -------------------------------------------
# The Growth page fills itself: it finds topics, finds Reddit threads worth
# answering, writes the replies, and discovers communities, all in the background.
# It NEVER posts and NEVER emails. Those stay a human paste, on purpose: a bad
# email cannot be recalled, and an automated comment gets the account banned.
#
# Nothing here is required. The defaults are deliberately unhurried because these
# are other people's APIs and Reddit rate limits hard.
#
# Kill switch. Set to 0 to stop the scheduled runs; the "Run everything now"
# button keeps working.
# GROWTH_AUTOPILOT=0
#
# Minimum hours between runs of each task.
# GROWTH_TRENDS_EVERY_HOURS=6
# GROWTH_REDDIT_EVERY_HOURS=8
# GROWTH_DRAFT_EVERY_HOURS=8
# GROWTH_COMMUNITIES_EVERY_HOURS=168     # weekly: communities barely change
#
# How many replies to write per run. Each one is an AI call, so this is a cost dial.
# GROWTH_DRAFTS_PER_RUN=5
#
# Score cutoffs. Raise them if the page fills with things not worth your time.
# GROWTH_MIN_HEAT=22                     # trends
# GROWTH_MIN_RELEVANCE=35                # Reddit threads

# --- Reddit listening (read-only discovery) ---------------------------------
# Reddit blocks unauthenticated JSON access, so the crawler needs a free app:
# reddit.com/prefs/apps -> create app -> type "script". Read-only; the crawler
# never posts, votes, or comments.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive UA naming the app and a contact. Do not spoof a browser.
# REDDIT_USER_AGENT=web:kloudbean-seo-storyboard:1.0 (by /u/yourname; contact hello@kloudbean.com)

# --- Email sending (broadcasts + outreach) ----------------------------------
# TWO independent switches must agree before a single real email goes out:
#   1. the caller passes dryRun:false (CLI: --for-real)
#   2. EMAIL_SEND_ENABLED=1 below
# Leave this unset and everything stays a dry run, which is the intended default.
# EMAIL_SEND_ENABLED=1

# Provider (global fallback). Resend and Brevo send over HTTPS with no dependency.
# SMTP is used only if the optional `nodemailer` package is installed.
# Per-account senders attached in the /email UI override these for their own sends.
# RESEND_API_KEY=
# BREVO_API_KEY=                 # Brevo (Sendinblue) transactional API key
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASSWORD=

# Sender identity. The postal address is a legal requirement for bulk commercial
# mail in most markets, and it appears in the footer of every send.
# OUTREACH_FROM_NAME=Kloudbean
# OUTREACH_FROM_EMAIL=hello@kloudbean.com
# OUTREACH_REPLY_TO=hello@kloudbean.com
# OUTREACH_POSTAL_ADDRESS=Kloudbean, <street, city, country>

# Volume guards. The cap counts real (non dry-run) sends since midnight, and the
# delay paces a batch so a warm sending domain stays warm.
# EMAIL_DAILY_CAP=60
# EMAIL_SEND_DELAY_MS=4000

# Unsubscribe. Every email carries a per-recipient link; the secret signs it so
# nobody can unsubscribe someone else by editing a query string.
#
# TWO THINGS TO GET RIGHT HERE, and both are easy to miss:
#
# 1. THE BASE URL MUST POINT AT THIS APP. The default below is the WordPress
#    marketing site, which does not serve /unsubscribe. This engine answers
#    /unsubscribe itself, so either point this at the engine's public URL, or
#    proxy www.kloudbean.com/unsubscribe through to it. A dead opt-out link is a
#    legal problem and mailbox providers read it as a bad-sender signal.
# 2. SET THE SECRET. Without it links are unsigned, and while the endpoint still
#    honours them (refusing would break links already sent), anyone could
#    unsubscribe somebody else by editing the address.
# UNSUBSCRIBE_BASE_URL=https://your-engine-host.example.com/unsubscribe
# UNSUBSCRIBE_SECRET=<long random string>

# ============================================================================
# BACKLINK AND GUEST-POST OUTREACH
#
# Reads the competitor exports in kloudgraph-semrush-export/, finds sites that
# already write about hosting, works out who to contact, and writes one specific
# email per opportunity. Everything except sending runs with no configuration.
#
# THE ORDER TO TURN THINGS ON:
#   1. Nothing set          -> it researches and drafts. Read the drafts in the
#                              Growth page, Backlinks tab. Safe.
#   2. Add a mailbox        -> it can read replies and bounces (see IMAP below).
#   3. EMAIL_SEND_ENABLED=1 -> real sending becomes POSSIBLE.
#   4. OUTREACH_AUTO_SEND=1 -> it sends without being asked.
# Do not do step 4 before step 2. Without reply reading, a follow-up will go to
# somebody who already answered, which is the one failure that costs a
# relationship rather than an email.
# ----------------------------------------------------------------------------

# --- Reading replies and bounces (IMAP) -------------------------------------
# This is what makes automatic follow-ups safe: it stops the sequence the moment
# somebody answers. A sending provider's webhook cannot do this, because a reply
# never reaches the sending provider, it goes to the reply-to mailbox.
#
# Needs one package, which is NOT installed by default:  npm i imapflow
# Without it, and without these variables, reply reading simply reports that it
# is unavailable and does nothing.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_SECURE=1
# IMAP_USER=outreach@kloudbean.com
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_MAX_PER_POLL=40

# --- Sequence: how many emails, how far apart -------------------------------
# One first email and one follow-up. A third touch is pressure, and its reply
# rate does not pay for the goodwill it costs.
# OUTREACH_MAX_TOUCHES=2
# OUTREACH_FOLLOWUP_DAYS=5

# Only send on weekday mornings, in the server's timezone. Not superstition about
# open rates: mail arriving at 3am Sunday looks automated, because it is.
# Off-window messages wait rather than being dropped.
# OUTREACH_SEND_HOUR_START=9
# OUTREACH_SEND_HOUR_END=17
# OUTREACH_IGNORE_SEND_WINDOW=1

# --- Protecting the sending domain ------------------------------------------
# A domain that has never sent cold email and suddenly sends 60 in a day looks
# exactly like a compromised account. Remember this is the SAME domain that sends
# password resets and invoices, so burning it to send outreach faster costs
# transactional email too.
#
# The ramp, in days of ACTUAL sending (not elapsed days, so a pause does not
# count as warming up): 5/day for the first 2 days, then 10, 20, 35, 50, then the
# configured cap. It can only ever LOWER the cap, never raise it.
# OUTREACH_WARMUP=0

# Emails to ONE organisation per day. Three emails to three people at the same
# magazine on one morning turns a real prospect into a spam report, and the miner
# makes that likely because one publisher can yield several contacts.
# OUTREACH_MAX_PER_DOMAIN_PER_DAY=1

# --- Letting it act without asking ------------------------------------------
# Approve drafted pitches automatically. Still refuses anything without a
# specific page of theirs to quote, anything suppressed, and anything scoring
# below the threshold.
# OUTREACH_AUTO_APPROVE=1
# OUTREACH_AUTO_APPROVE_MIN_VALUE=60

# Send automatically. Needs EMAIL_SEND_ENABLED=1 as well; this is a second,
# deliberate switch so sending cannot start by accident.
# OUTREACH_AUTO_SEND=1

# Hold back a pitch when the address we found probably belongs to a different
# company (for example a .ie site whose only address was on a .eu domain).
# LINK_PITCH_MIN_CONFIDENCE=0.5

# --- The research crawler ---------------------------------------------------
# This reads thousands of other people's public pages, so it identifies itself
# truthfully, honours robots.txt, and pauses between requests. Please keep it
# polite: the alternative is being blocked, which ends the programme.
# OUTREACH_CRAWLER_UA=KloudbeanResearchBot/1.0 (+https://www.kloudbean.com/; contact hello@kloudbean.com)
# CONTACT_CRAWL_DELAY_MS=1200
# CONTACT_FETCH_TIMEOUT_MS=9000
# CONTACT_CRAWL_PER_RUN=25

# --- How often each step runs (hours) ---------------------------------------
# LINKS_MINE_EVERY_HOURS=168          # the exports only change when you download new ones
# LINKS_CONTACTS_EVERY_HOURS=12       # slowest step: real HTTP with pauses
# LINKS_DRAFT_EVERY_HOURS=12
# LINKS_FOLLOWUP_EVERY_HOURS=12
# LINKS_REPLY_POLL_EVERY_HOURS=1      # frequent: an unread reply is a risk
# LINKS_SEND_EVERY_HOURS=2            # spreads the day's allowance instead of one burst

# --- Did the link actually appear? (v26) ------------------------------------
# The only part of this system that measures an OUTCOME rather than an activity.
# It fetches the page we pitched and looks for a real <a href> to us, records the
# rel attributes exactly as published, and notices when a link that was there has
# gone. A nofollow link is recorded honestly and does NOT count as a win.
# LINK_CHECK_TIMEOUT_MS=12000
# LINK_CHECK_DELAY_MS=1500
# LINK_CHECK_PER_RUN=20
# Extra domains that count as "ours" beyond kloudbean.com, comma separated.
# LINK_CHECK_OUR_DOMAINS=
# LINKS_VERIFY_EVERY_HOURS=24         # daily: a link usually appears days later,
#                                     # and one that vanishes should not go unnoticed
# Below this many measured outcomes, a percentage is withheld rather than shown.
# "33% from 3 emails" is noise wearing a percentage sign.
# LINK_METRICS_MIN_SAMPLE=12

# ============================================================================
# FINDING PROSPECTS: THE FIVE RECIPES (v27)
# ============================================================================
# Five different questions, one pipeline. Whatever a recipe finds joins the normal
# list and gets an email written in wording that matches HOW it was found.
#
#   Who links to a rival's article   reads the backlink exports on disk. FREE.
#   Who reviewed a rival recently    reads the backlink exports on disk. FREE.
#   Who takes guest posts            needs SERPER_API_KEY.
#   Podcasts someone has been on     needs SERPER_API_KEY.
#   Resource lists on a topic        needs SERPER_API_KEY.
#
# The first two cost nothing because the competitor exports in
# kloudgraph-semrush-export/ already record the exact target URL of every link, so
# "who cites this specific article" is answerable from real backlink data rather
# than guessed from search results.
#
# NOTE ON THE SEARCH ONES: a key being SET is not the same as the account having
# credits. There is no way to check a balance without spending a query, so the UI
# reports the last real failure instead of claiming to know. If a recipe reports
# "run out of credits", top up the Serper account; the two free ones keep working.

# Hard limit on searches per recipe run. Capped at 30 whatever is set here.
# Each query costs money, and a run that fires 48 sequential searches would also
# hit the job queue's two-minute timeout having paid for all of them.
# RECIPE_MAX_QUERIES=12
# A candidate scoring under this is rejected with a reason rather than kept.
# Same floor the miner uses, so both paths agree. A kept row scoring 0 is never
# crawled, never pitched and never seen again, while still counting as a find.
# RECIPE_MIN_VALUE=8

# ============================================================================
# SENDING FROM SEVERAL ADDRESSES (v27)
# ============================================================================
# WHY. One mailbox has a practical ceiling, and the ceiling is reputation rather
# than volume: the same domain sends your receipts and password resets, so pushing
# outreach through it puts transactional mail at risk. Several addresses lower the
# volume per address, which is what mailbox providers actually judge.
#
# WHY THIS IS ALSO HOW PEOPLE GET BLOCKED. Thirty new addresses each sending
# twenty cold emails on day one is a textbook spam pattern, and it burns the whole
# domain rather than one mailbox. So every address gets its own warmup ramp, its
# own daily cap, and is paused automatically if its bounce rate goes bad.
#
# ADDING ADDRESSES DOES NOT RAISE THE DAILY TOTAL. EMAIL_DAILY_CAP still decides
# how much goes out; more addresses spread that same number across more of them.
# Anything else would make this a tool for sending more, which is the failure it
# exists to prevent.
#
# THREAD AFFINITY: a conversation keeps the address that started it, for its whole
# life. If that address is paused or out of budget, the follow-up WAITS. It never
# goes out from a different address, because a follow-up arriving from a stranger
# breaks threading in their mail client and reads as spam.

# --- The simple way: many addresses, one provider ---------------------------
# One line. Every address here uses your existing provider settings above, which
# is what "twenty addresses on one verified domain" means in practice. An optional
# display name goes after a pipe.
# OUTREACH_INBOX_ADDRESSES=vikram@kloudbean.com|Vikram, hello@kloudbean.com|Kloudbean, outreach@kloudbean.com

# Default per-address daily cap. Deliberately low: spread is the point, not speed.
# OUTREACH_INBOX_DAILY_CAP=15

# Pause an address whose bounces plus complaints pass this percentage. Only acts
# once that address has 20 real sends, so one bounce on a new address does nothing.
# Automatic on purpose: a rate on a dashboard is not a control, and by the time
# somebody notices it climbing the damage to that address is already done.
# OUTREACH_MAX_BOUNCE_RATE=5

# How often to pick up new addresses and pause unhealthy ones. Six hours rather
# than daily because this is the task that stops a bad address, and a day of
# sending from one is a day of damage. The task itself is two queries.
# INBOX_TEND_EVERY_HOURS=6

# --- The harder way: addresses on DIFFERENT accounts or providers -----------
# Numbered blocks, found by scanning rather than by a count, so a gap in the
# numbering cannot silently truncate the pool. One pool can mix Resend and SMTP.
#
# NO PASSWORD IS EVER STORED IN THE DATABASE. The inbox row keeps only the NAME of
# the block ("INBOX_1"), and the key is read from here at the moment of sending.
# That way a routine database dump cannot leak thirty mailbox credentials, and an
# address whose credential is missing is REFUSED rather than quietly falling back
# to the global sender, because mailing from the wrong address is worse than not
# mailing.
#
# INBOX_1_FROM_EMAIL=vikram@kloudbean.com
# INBOX_1_FROM_NAME=Vikram
# INBOX_1_REPLY_TO=vikram@kloudbean.com
# INBOX_1_PROVIDER=smtp                 # smtp | resend
# INBOX_1_SMTP_HOST=smtp.example.com
# INBOX_1_SMTP_PORT=587
# INBOX_1_SMTP_SECURE=0
# INBOX_1_SMTP_USER=vikram@kloudbean.com
# INBOX_1_SMTP_PASSWORD=
# INBOX_1_DAILY_CAP=15
#
# INBOX_2_FROM_EMAIL=hello@kloudbean.com
# INBOX_2_PROVIDER=resend
# INBOX_2_RESEND_API_KEY=

# === MARKETING COMMAND — outbound "acting" steps (post_social / send_email) ===
# All OFF by default: acting steps DRAFT/SIMULATE (dry-run) and only transmit
# when the matching switch below is armed. Nothing goes out until you set these.
#
# Social auto-post: post to ONE webhook that fans out to your real accounts
# (point it at your own n8n workflow, Zapier, Make, or Buffer).
# SOCIAL_AUTOPOST_ENABLED=1
# SOCIAL_WEBHOOK_URL=https://your-n8n-instance/webhook/kloudbean-social
#
# Email broadcast: reuses the guarded sender (unsubscribe + suppression + cap).
# Needs BOTH the send switch AND a provider (Resend or SMTP), plus recipients.
# EMAIL_SEND_ENABLED=1
# RESEND_API_KEY=your-resend-key            # or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD
# BROADCAST_RECIPIENTS=you@example.com,team@example.com
# EMAIL_DAILY_CAP=60
# UNSUBSCRIBE_BASE_URL=https://www.kloudbean.com/unsubscribe
# UNSUBSCRIBE_SECRET=a-long-random-string
