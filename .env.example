# === LOCAL (default) — Docker Postgres on your Mac ===
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=seo_storyboard
DATABASE_USER=seo
DATABASE_PASSWORD=changeme
DATABASE_SSL=false

# Start DB: npm run db:up
# Setup:    npm run setup
# Dev:      npm run dev
# All-in-one: npm run dev:local

# DataForSEO — https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Serper.dev — cheap SERP/keyword discovery (PREFERRED over DataForSEO)
# Get a key at https://serper.dev — used for autocomplete, PAA, related searches, SERP.
SERPER_API_KEY=

# AI — DeepSeek preferred (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Fallback OpenAI-compatible (OpenRouter, OpenAI, Groq, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=openai/gpt-4o-mini

# WordPress (optional)
WP_SITE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Kloudbean RAG knowledge base (grounds content in live product facts)
# Defaults to the hosted endpoint; set KLOUDBEAN_RAG_DISABLED=1 to turn off.
KLOUDBEAN_RAG_URL=https://vhbbmovxfuuqzfywysba.supabase.co/functions/v1/rag-chat
# KLOUDBEAN_RAG_DISABLED=1

# Content Quality Engine tuning
CONTENT_MIN_SCORE=82          # auto-revise until the draft scores at least this
CONTENT_MAX_REVISIONS=2       # max AI editor passes per article

# Automation (scripts/automate.mjs — schedule with cron when self-hosting)
# AUTOMATE_LIMIT=5
# AUTOMATE_PUBLISH=1          # 1 = auto-publish high-scoring drafts
# AUTOMATE_PUBLISH_STATUS=publish   # draft | publish
# AUTOMATE_MIN_SCORE=88      # only auto-publish at/above this score

PORT=3000

# WordPress Plugin (Kloudbean SEO Engine plugin) — replaces basic WP REST
# WP_PLUGIN_URL=https://kloudbean.com/wp-json/kbseo/v1
# WP_PLUGIN_API_KEY=from-wp-admin-settings-page

# Tool pages: signup gate (lead-gen — require a console account to use a tool)
# TOOL_SIGNUP_URL=https://console.kloudbean.com   # where the gate sends users
# TOOL_GATE_MODE=soft           # soft (1 free use then gate) | hard (locked immediately)
# TOOL_GATE_FREE=1              # free interactions before the gate (soft mode)
# TOOL_GATE_DEFAULT=0           # 1 = gate every NEW generated tool by default

# Image generation (optional — falls back to stock photos, then placeholder)
# UNSPLASH_ACCESS_KEY=your-unsplash-key
# PEXELS_API_KEY=your-pexels-key

# Autopilot scheduler (fully autonomous mode)
# AUTOPILOT_ENABLED=1
# AUTOPILOT_INTERVAL_MS=21600000    # 6 hours
# AUTOPILOT_MAX_PER_DAY=2
# AUTOPILOT_MAX_PER_WEEK=7
# AUTOPILOT_MIN_SCORE=85
# AUTOPILOT_TOPICS_PER_RUN=5
# AUTOPILOT_PROGRESS_PER_RUN=3
# AUTOPILOT_GEO=global
# AUTOPILOT_PUBLISH=1               # 0 to disable auto-publish
# AUTOPILOT_USE_PLUGIN=1            # 0 to use basic WP REST instead

# --- Autopilot: Tool Pages phase (Elementor free tools) ---
# AUTOPILOT_TOOLS=1                 # master switch for the tool-pages phase (default off)
# AUTOPILOT_TOOLS_DISCOVER=3        # discover N new tool ideas per cycle (0 = off)
# AUTOPILOT_TOOLS_GENERATE=1        # generate N pending ideas into full tools per cycle
# AUTOPILOT_TOOLS_PUBLISH=draft     # off | draft | publish (draft = review before live)
# AUTOPILOT_TOOLS_OPTIMIZE=3        # optimize N worst-scoring existing pages per cycle (additive, slug-safe)
# AUTOPILOT_JOBS_PER_RUN=10         # durable bulk jobs (build/optimize) drained per cycle
# TOOL_MIN_QUALITY=70               # min tool quality score to auto-publish LIVE

# Weekly digest notification (Slack/Discord webhook)
# DIGEST_WEBHOOK_URL=https://hooks.slack.com/services/...

# === OWN ANALYTICS — Google Search Console (free, first-party ranking data) ===
# This replaces any paid third-party ranking tool. Real clicks/impressions/
# position per URL feed the self-learning ranker so discovery learns what wins.
# Setup:
#   1. Google Cloud Console → create a service account → create a JSON key.
#   2. Search Console → Settings → Users and permissions → add the service
#      account email as a user on the kloudbean.com property (Restricted is fine).
#   3. Fill these in (keep the \n escapes in the private key on one line):
# GSC_CLIENT_EMAIL=seo-engine@your-project.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# GSC_SITE_URL=https://www.kloudbean.com/        # or: sc-domain:kloudbean.com

# Instant indexing (B1) — push new/updated URLs to search engines on publish.
#   IndexNow (Bing/Yandex/Seznam/Naver): the WP plugin auto-hosts a key file and
#   submits on publish, so no config is needed. To run IndexNow from the engine
#   with your own key instead, set INDEXNOW_KEY (and host {key}.txt at site root).
# INDEXNOW_KEY=
# INDEXNOW_DISABLED=1                              # set to disable IndexNow entirely
#   Google Indexing API (optional, needs extra setup): reuses the GSC service
#   account, but it must be added as an OWNER of the property and the Indexing
#   API must be enabled in the Google Cloud project. Then:
# GOOGLE_INDEXING_ENABLED=1

# Multi-engine AI citation tracking (A2) — is Kloudbean cited in AI answers?
# Each engine is optional + independent; add the keys for the ones you want.
# PERPLEXITY_API_KEY=pplx-...            # Perplexity (real source citations)
# PERPLEXITY_MODEL=sonar
# GEMINI_API_KEY=...                     # Gemini (Google-grounded answers + sources)
# GEMINI_MODEL=gemini-2.0-flash
#   OpenAI/ChatGPT citation checks reuse OPENAI_API_KEY (only when it's a real
#   OpenAI key, not DeepSeek/OpenRouter). Brand-mention proxy from model knowledge.
# CITATION_OPENAI_MODEL=gpt-4o-mini

# Autopilot: periodically probe AI engines for Kloudbean citations (needs the
# citation API keys above). Off by default.
# AUTOPILOT_CITATIONS=1
# AUTOPILOT_CITATIONS_PER_RUN=5

# Entity boilerplate (C4) — official Kloudbean profiles for Organization sameAs
# (G2, LinkedIn, Crunchbase, etc.). Comma-separated. Left empty by default so we
# never ship guessed profile URLs. The WP plugin also serves /llms.txt site-wide.
# KLOUDBEAN_SAMEAS=https://www.linkedin.com/company/kloudbean,https://www.g2.com/products/kloudbean

# Article author for E-E-A-T (schema expansion). If set, articles attribute a
# real Person (stronger E-E-A-T); otherwise the Kloudbean Editorial Team.
# ARTICLE_AUTHOR_NAME=Jane Doe
# ARTICLE_AUTHOR_URL=https://kloudbean.com/author/jane

# Freshness / decay: how many days before a published article is due for review.
# (Falls back to AUTOPILOT_REFRESH_DAYS, then 90.) The autopilot refreshes the
# highest-priority due articles each cycle (prioritised by GSC decay signal).
# CONTENT_REVIEW_DAYS=90

# Conversion attribution: console.kloudbean.com reports signup/paid events to the
# WP plugin webhook so the engine can attribute them to the page that drove them
# and optimise the learning loop for revenue (not just clicks).
#   Webhook (console -> plugin, authenticated with the plugin API key):
#     POST https://www.kloudbean.com/wp-json/kbseo/v1/conversion
#     Header: X-KB-API-Key: <WP_PLUGIN_API_KEY>
#     Body: {"event":"signup|paid","external_id":"...","value":12.0,"currency":"USD",
#            "source_url":"<the inbound link with kbsrc/kbsurface>","plan":"..."}
#   Console links already carry kbsrc (source slug) + kbsurface (tool|article).
#   The engine auto-pulls + attributes on each autopilot cycle (no extra env needed).
