# ElevenLabs voiceover (used by `node render-all.mjs --voiceover`).
# Put your key here (copy to .env) or in the project-root .env.
ELEVENLABS_API_KEY=
# Optional — a voice from your ElevenLabs account (defaults to a standard voice):
ELEVENLABS_VOICE_ID=
# Optional model + timing tuning:
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VO_PAD_SECONDS=0.6
VO_MIN_BEAT=2.4
